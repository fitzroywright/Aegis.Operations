# systemd EnvironmentFile: one NAME=value per line. Quote entire values with spaces.
# Incomplete intentionally: bootstrap creates no secrets and does not start service.
ASPNETCORE_ENVIRONMENT=Production
DOTNET_ENVIRONMENT=Production
ASPNETCORE_URLS=https://0.0.0.0:5443
AllowedHosts=CHANGE_ME_BRIDGE_DNS_NAME
Kestrel__Certificates__Default__Path=/etc/aegis-ffpmanager-bridge/tls/fullchain.pem
Kestrel__Certificates__Default__KeyPath=/etc/aegis-ffpmanager-bridge/tls/privatekey.pem
Bridge__ServiceIdentity=FfpManager.Bridge
Bridge__Gateway=Sql
# Production authorizes only JMDB01/FFPJM. Rehearsal authorizes only JMDB01/FFP.
# Change together with the protected OpenBao target after schema/backup verification.
Bridge__SqlTarget=Production
Bridge__RequestPortalBaseUrl=CHANGE_ME_HTTPS_PORTAL_ORIGIN
Bridge__SupportingDocumentRoot=CHANGE_ME_MOUNTED_TEST_DOCUMENT_DIRECTORY
# Windows-visible path to the SAME directory; quote to preserve UNC backslashes.
Bridge__SupportingDocumentManagerRoot='CHANGE_ME_APPROVED_WINDOWS_UNC_DIRECTORY'
Bridge__InitialApplicationStatus=CHANGE_ME_REAL_FFP_STATUS
# Replace both mapping key suffixes and values with real agreed lookup values.
Bridge__StatusMap__CHANGE_ME=CHANGE_ME
Bridge__DocumentTypeMap__CHANGE_ME=CHANGE_ME
Bridge__EnableOutboxDispatch=true
Bridge__SharedSecretSecretName=FfpManagerIntegration:SharedSecret
Bridge__SqlConnectionStringSecretName=FfpManagerBridge:SqlConnectionString
CommonSecrets__Mode=Production
CommonSecrets__WorkloadName=FfpManager.Bridge
CommonSecrets__EnvironmentName=Production
CommonSecrets__ProviderOrder__0=PrimarySecrets
CommonSecrets__Providers__PrimarySecrets__Type=OpenBao
CommonSecrets__Providers__PrimarySecrets__Settings__Enabled=true
CommonSecrets__Providers__PrimarySecrets__Settings__RequireHttps=true
CommonSecrets__Providers__PrimarySecrets__Settings__Address=CHANGE_ME_HTTPS_OPENBAO_ORIGIN
CommonSecrets__Providers__PrimarySecrets__Settings__MountPath=secret
CommonSecrets__Providers__PrimarySecrets__Settings__BasePath=CHANGE_ME_APPROVED_SECRET_BASE_PATH
CommonSecrets__Providers__PrimarySecrets__Settings__RoleId=CHANGE_ME_WORKLOAD_ROLE_ID
# Protected, renewable workload bootstrap. Rotate under the organization's policy.
# Persist for service restarts; do not use a deleted one-time file without reprovisioning it.
CommonSecrets__Providers__PrimarySecrets__Settings__SecretIdFile=/etc/aegis-ffpmanager-bridge/openbao-secret-id
CommonSecrets__Providers__PrimarySecrets__Settings__RequireSecretIdFileInProduction=true
CommonSecrets__Providers__PrimarySecrets__Settings__DeleteSecretIdFileAfterRead=false
