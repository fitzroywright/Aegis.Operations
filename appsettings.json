{
  "Operations": {
    "Site": "",
    "Environment": "",
    "RegistrationDirectory": "/var/lib/aegis/operations/registration",
    "RegistrationCredentialFile": "/var/lib/aegis/operations/registration/operations.key",
    "RequestTimeoutSeconds": 3,
    "DataDirectory": "/var/lib/aegis/operations/v1",
    "StaleAfterSeconds": 90,
    "Retention": {
      "Flows": 1000,
      "Alerts": 5000,
      "EngineerLog": 5000,
      "HistoryView": 500
    }
  },
  "CommonSecrets": {
    "Mode": "Production",
    "ProviderOrder": [
      "PrimarySecrets"
    ],
    "WorkloadName": "Aegis.Operations",
    "Providers": {
      "PrimarySecrets": {
        "Type": "OpenBao",
        "Settings": {
          "Enabled": true,
          "Address": "https://openbao.ffpja.org",
          "MountPath": "secret",
          "BasePath": "aegis/operations",
          "AuthMountPath": "approle",
          "RequireHttps": true,
          "SecretIdEnvironmentVariable": "AEGIS_OPERATIONS_OPENBAO_SECRET_ID",
          "RenewTokens": true,
          "RevokeTokenOnDispose": true
        }
      }
    }
  },
  "AuthenticationPlugin": {
    "Enabled": true,
    "AssemblyPath": "plugins/Common.Security.Plugin.ActiveDirectory.dll",
    "Settings": {
      "Domain": "",
      "SearchBase": "",
      "Port": 636,
      "TimeoutSeconds": 5,
      "Servers": [],
      "AdministrativeGroups": []
    }
  },
  "SuiteSecurity": {
    "Mode": "ActiveDirectory"
  }
}
